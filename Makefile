CC        := gcc
CFLAGS    := -Wall -Wextra -O2 -std=gnu11 -MMD -MP

SRC_DIR   := src
BUILD_DIR := build

# ---- the three programs ----
PLAIN_SENDER   := $(BUILD_DIR)/sender      # old, plain TCP, no protection
PLAIN_RECEIVER := $(BUILD_DIR)/receiver    # old, plain TCP, no protection
AES_TARGET     := $(BUILD_DIR)/network     # new, AES-256-GCM protected

# ---- which object files go into which program ----
PLAIN_SENDER_OBJS   := $(BUILD_DIR)/sender.o
PLAIN_RECEIVER_OBJS := $(BUILD_DIR)/receiver.o
AES_OBJS            := $(BUILD_DIR)/main.o \
                       $(BUILD_DIR)/senderAES.o \
                       $(BUILD_DIR)/receiverAES.o

ALL_OBJS := $(BUILD_DIR)/relay.o $(PLAIN_SENDER_OBJS) $(PLAIN_RECEIVER_OBJS) $(AES_OBJS)
DEPS     := $(ALL_OBJS:.o=.d)

# default: build everything
all: $(PLAIN_SENDER) $(PLAIN_RECEIVER) $(AES_TARGET) $(BUILD_DIR)/relay

# shortcuts: build only one group
plain: $(PLAIN_SENDER) $(PLAIN_RECEIVER)
aes: $(AES_TARGET)

# ---- linking ----
# The plain programs do not need OpenSSL.
$(PLAIN_SENDER): $(PLAIN_SENDER_OBJS)
	$(CC) $^ -o $@

$(PLAIN_RECEIVER): $(PLAIN_RECEIVER_OBJS)
	$(CC) $^ -o $@

# Only the AES program needs -lcrypto (the OpenSSL library).
$(AES_TARGET): $(AES_OBJS)
	$(CC) $^ -o $@ -lcrypto

# ---- compiling: every .c becomes a .o ----
# "| $(BUILD_DIR)" makes sure the build/ folder exists first.
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -f $(ALL_OBJS) $(DEPS) $(PLAIN_SENDER) $(PLAIN_RECEIVER) $(AES_TARGET) $(BUILD_DIR)/relay

# header dependencies generated by -MMD: editing a .h rebuilds the right .c files
-include $(DEPS)

.PHONY: all plain aes clean

# Four-stage transfer (sender -> encoder -> decoder -> receiver).
relay: $(BUILD_DIR)/relay

$(BUILD_DIR)/relay: $(BUILD_DIR)/relay.o
	$(CC) $^ -o $@ -lcrypto

.PHONY: relay

# Demonstration commands. Run each role in its own terminal.
SUDO ?= sudo
INPUT ?= data/input.txt
OUTPUT ?= output/relay-output.txt
KEY ?= data/key.bin

prepare: all
	mkdir -p data output
	@test -f "$(INPUT)" || printf 'Hello from the network demonstration!\n' > "$(INPUT)"
	@if [ ! -e "$(KEY)" ]; then (umask 077; openssl rand -out "$(KEY)" 32); fi
	@test "$$(wc -c < "$(KEY)")" -eq 32 || { echo 'Key must be exactly 32 bytes'; exit 1; }

up:
	$(SUDO) bash scripts/setup-netns.sh

down:
	$(SUDO) bash scripts/teardown-netns.sh

status:
	$(SUDO) ip netns list
	@for ns in sender-ns receiver-ns; do \
		if $(SUDO) ip netns list | awk '{print $$1}' | grep -Fxq "$$ns"; then \
			$(SUDO) ip -n "$$ns" -br addr; \
			$(SUDO) ip netns pids "$$ns"; \
		fi; \
	done

plain-receiver: plain
	$(SUDO) ip netns exec receiver-ns ./build/receiver
plain-sender: plain
	$(SUDO) ip netns exec sender-ns ./build/sender

aes-receiver: aes
	$(SUDO) ip netns exec receiver-ns ./build/network receiver
aes-sender: aes
	$(SUDO) ip netns exec sender-ns ./build/network sender

relay-listener: relay
	$(SUDO) ip netns exec receiver-ns ./build/relay receiver "$(OUTPUT)" 127.0.0.1 5002
relay-decoder: relay
	$(SUDO) ip netns exec receiver-ns ./build/relay decoder 10.0.0.2 5001 127.0.0.1 5002 "$(KEY)"
relay-encoder: relay
	$(SUDO) ip netns exec sender-ns ./build/relay encoder 127.0.0.1 5000 10.0.0.2 5001 "$(KEY)"
relay-sender: relay
	$(SUDO) ip netns exec sender-ns ./build/relay sender "$(INPUT)" 127.0.0.1 5000

capture:
	$(SUDO) ip netns exec receiver-ns tcpdump -i veth-recv -nn -A 'tcp port 5000'
capture-relay:
	$(SUDO) ip netns exec receiver-ns tcpdump -i veth-recv -nn -A 'tcp port 5001'

check:
	cmp data/input.txt output/output.txt
	@echo 'SUCCESS: files match'
check-relay:
	cmp "$(INPUT)" "$(OUTPUT)"
	@echo 'SUCCESS: files match'

test: relay
	python3 tests/test-relay.py

help:
	@echo 'First: make prepare; make up'
	@echo 'Plain: make capture | make plain-receiver | make plain-sender; make check'
	@echo 'AES:   make capture | make aes-receiver | make aes-sender; make check'
	@echo 'Relay: make capture-relay | make relay-listener | make relay-decoder | make relay-encoder | make relay-sender; make check-relay'
	@echo 'Each command separated by | above belongs in a separate terminal (not a shell pipeline).'
	@echo 'Other commands: make status; make test; make down'
	@echo 'make up recreates the lab and stops previous processes in its namespaces.'

.PHONY: prepare up down status plain-receiver plain-sender aes-receiver aes-sender relay-listener relay-decoder relay-encoder relay-sender capture capture-relay check check-relay test help
